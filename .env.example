# Copy this file to .env and fill in the values.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=community_forum

# Web server (3001 so it can run next to other projects on 3000)
PORT=3001

# Any long random string. Used to sign login cookies.
SESSION_SECRET=change-me-to-a-long-random-string
